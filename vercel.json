{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "installCommand": "npm install --no-audit --no-fund",
  "buildCommand": "node -e \"const fs=require('fs');const p='lib/cisc-section-library-v05.ts';const s=fs.readFileSync(p,'utf8');fs.writeFileSync(p,s.replace(/diaphhragms/g,'diaphragms'));\" && next build"
}
