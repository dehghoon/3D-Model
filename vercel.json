{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm cache clean --force && npm install --force --prefer-online",
  "buildCommand": "node -e \"const fs=require('fs');const p='components/StructuralEditorV05.tsx';const s=fs.readFileSync(p,'utf8');fs.writeFileSync(p,s.replace(/diaphhragms/g,'diaphragms'));\" && next build"
