# FastAPI base URL for the W-section verification service.
# Example: https://steel-verification.onrender.com
W_SECTION_API_BASE_URL=

# Approved CISC section catalog service. May point to the same FastAPI service.
# Falls back to W_SECTION_API_BASE_URL when omitted.
CISC_SECTION_API_BASE_URL=

# Wind Calculator server origin. Defaults to https://wind-calculator.vercel.app
WIND_CALCULATOR_API_URL=
